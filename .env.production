# Production Environment Configuration for Vercel
# Set these as Environment Variables in Vercel Dashboard:
# https://vercel.com/docs/projects/environment-variables

# Database (Use managed database service like PlanetScale, AWS RDS, DigitalOcean)
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=${DB_NAME}

# Email Configuration (Use SendGrid, AWS SES, Mailgun, etc.)
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_FROM=${MAIL_FROM}

# Twilio WhatsApp & SMS
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}
TWILIO_WHATSAPP_NUMBER=${TWILIO_WHATSAPP_NUMBER}

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Kigali
