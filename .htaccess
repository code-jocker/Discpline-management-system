# Protect environment files
<FilesMatch "^\.env$">
    Require all denied
</FilesMatch>

# Route API requests
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^whatsapp-service(?:/|$) - [F,L]
    RewriteRule ^api/v1(?:/(.*))?$ api/v1/index.php [L,QSA]
    RewriteRule ^api(?:/(.*))?$ api/index.php [L,QSA]
</IfModule>
