# SBMS Environment Configuration
# Copy this file to .env and fill in your actual values

# Database
# Legacy SBMS code paths also support SBMS_DB_* names.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sbms
SBMS_DB_HOST=localhost
SBMS_DB_PORT=3306
SBMS_DB_USER=root
SBMS_DB_PASS=
SBMS_DB_NAME=sbms

# Email Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@sbms.local

# ╔════════════════════════════════════════════════════════════════╗
# ║  TWILIO CONFIGURATION - WhatsApp & SMS Messaging              ║
# ╚════════════════════════════════════════════════════════════════╝

# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your SMS phone number (for SMS notifications)
# Format: +1415xxxxxxx (with + and country code)
TWILIO_PHONE_NUMBER=+1415xxxxxxx

# Your WhatsApp number (usually same as SMS number in Sandbox)
# For production: Request WhatsApp Business Account from Twilio
# Format: +1415xxxxxxx (with + and country code)
TWILIO_WHATSAPP_NUMBER=+1415xxxxxxx

# ╔════════════════════════════════════════════════════════════════╗
# ║  APPLICATION SETTINGS                                          ║
# ╚════════════════════════════════════════════════════════════════╝

APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Africa/Kigali

# ═════════════════════════════════════════════════════════════════
# HOW TO FILL IN TWILIO VALUES:
# 
# 1. Sign up at https://www.twilio.com
# 
# 2. Go to Console Dashboard:
#    - Find "Account SID" and copy it → TWILIO_ACCOUNT_SID
#    - Find "Auth Token" and copy it → TWILIO_AUTH_TOKEN
#
# 3. Get a phone number:
#    - Free Sandbox: Use Twilio's trial numbers (SMS + WhatsApp)
#    - Paid: Purchase/request a phone number from Twilio
#
# 4. Get WhatsApp:
#    - Free Sandbox: Auto-enabled with trial account
#    - Paid: Request WhatsApp Business Account (24-48 hours)
#
# 5. Test: php test_whatsapp.php
#
# See WHATSAPP_SETUP.md for detailed instructions
# ═════════════════════════════════════════════════════════════════
