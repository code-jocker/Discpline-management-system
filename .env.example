# SBMS Environment Configuration
# Copy this file to .env and fill in your actual values

# Database
# Legacy SBMS code paths also support SBMS_DB_* names.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sbms
SBMS_DB_HOST=localhost
SBMS_DB_PORT=3306
SBMS_DB_USER=root
SBMS_DB_PASS=
SBMS_DB_NAME=sbms

# For Aiven / managed MySQL (hosted)
# SBMS_DB_SSL_MODE=required
# SBMS_DB_SSL_CA=/path/to/ca.pem

# Email Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@sbms.local

# ╔════════════════════════════════════════════════════════════════╗
# ║  WHATSAPP WEB (whatsapp-web.js worker)                         ║
# ╚════════════════════════════════════════════════════════════════╝
# SBMS enqueues WhatsApp messages to notification_queue; the Node worker
# in whatsapp-worker/ sends them. See whatsapp-worker/README.md.
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WORKER_URL=http://localhost:3100
WHATSAPP_WORKER_TOKEN=
WHATSAPP_COUNTRY_CODE_DEFAULT=250

# ╔════════════════════════════════════════════════════════════════╗
# ║  APPLICATION SETTINGS                                          ║
# ╚════════════════════════════════════════════════════════════════╝

APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Africa/Kigali

# Comma-separated browser origins allowed to call /api/* (Firebase + Vercel).
ALLOWED_ORIGINS=https://clever-c5b37.web.app,https://clever-c5b37.firebaseapp.com,https://sbms-ten.vercel.app
