# Database Configuration
# Copy this to .env and fill in your PlanetScale credentials

DB_HOST=aws.connect.psdb.cloud
DB_PORT=3306
DB_USER=your_planetscale_username
DB_PASSWORD=your_planetscale_password
DB_NAME=sbms

# Legacy SBMS environment names are also supported by the app.
# You can set either DB_* or SBMS_DB_* values.
# SBMS_DB_HOST=aws.connect.psdb.cloud
# SBMS_DB_PORT=3306
# SBMS_DB_USER=your_planetscale_username
# SBMS_DB_PASS=your_planetscale_password
# SBMS_DB_NAME=sbms

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Kigali
APP_URL=https://your-infinityfree-domain.com

# Frontend URL (for CORS)
FRONTEND_URL=https://sbms-ten.vercel.app
ALLOWED_ORIGINS=https://sbms-ten.vercel.app

# Email Configuration (Optional - Leave blank to skip)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@sbms.local

# Twilio Configuration (Optional - for WhatsApp/SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Session Configuration
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_HTTP_ONLY=true

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30
