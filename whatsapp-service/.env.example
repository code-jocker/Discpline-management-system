# ---------------------------------------------------------------------------
# SBMS WhatsApp service configuration.
# Copy this file to .env and adjust the values. Never commit .env.
# ---------------------------------------------------------------------------

# MySQL / MariaDB (the SBMS database that holds notification_queue).
# Dev is XAMPP MariaDB on port 3307, user root, no password.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=sbms_legacy_run

# HTTP port for the health endpoint consumed by the PHP admin page.
PORT=3001

# How long the worker sleeps when the queue is empty (milliseconds).
WORKER_POLL_MS=3000

# How many jobs the worker sends concurrently. Keep at 1: whatsapp-web.js is
# single-session and sending faster raises the risk of account restriction.
MAX_PARALLEL=1

# Jobs left in 'processing' for longer than this (a crashed worker) are handed
# back to the queue on startup. Minutes.
STALE_PROCESSING_MINUTES=10

# Shared secret protecting GET /health. The endpoint exposes parent phone
# numbers and queue volumes, so set this in production and send the value in
# the `x-health-token` request header. Leave empty for local development only.
HEALTH_TOKEN=

# Optional: path to an installed Chrome/Chromium. Needed when dependencies were
# installed with PUPPETEER_SKIP_DOWNLOAD=true. Example on Windows:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=

# How long Puppeteer waits for a browser command before aborting startup.
# Slow school machines need more than the 30s default. Milliseconds.
PROTOCOL_TIMEOUT_MS=180000
