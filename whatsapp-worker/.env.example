# SBMS WhatsApp Web worker (whatsapp-web.js)
# Copy to .env and set values. The worker reads jobs from SBMS notification_queue.

# MySQL (same DB as SBMS). For Aiven, set DB_SSL=true and provide CA if required.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sbms
DB_SSL=false
# Optional: path to CA certificate (Aiven / managed MySQL)
# DB_SSL_CA=/path/to/ca.pem

# Worker HTTP health endpoint (used by SBMS admin queue page)
WORKER_PORT=3100
WORKER_HOST=0.0.0.0
# Optional bearer token; if set, SBMS should send it as Authorization: Bearer <token>
# WORKER_AUTH_TOKEN=

# WhatsApp session persistence (LocalAuth)
WHATSAPP_SESSION_PATH=.wwebjs_auth
WHATSAPP_CLIENT_ID=sbms

# Processing
POLL_INTERVAL_MS=5000
BATCH_SIZE=10
MAX_ATTEMPTS=5
# Base backoff in seconds (exponential)
BACKOFF_BASE_SECONDS=30
BACKOFF_MAX_SECONDS=3600
